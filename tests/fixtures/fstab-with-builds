# /etc/fstab, generated by ProxSpace. Every run rewrites it whole, so edits
# made here are lost. For the file format, see the cygwin Users Guide:
# http://cygwin.com/cygwin-ug-net/using.html#mount-table

# Drives as /c, /d ... rather than /cygdrive/c.
none / cygdrive binary,posix=0,noacl,user 0 0

# $HOME inside the shell, and where the proxmark3 sources are checked out.
C:\ProxSpace\pm3 /pm3 ntfs noacl 0 0

# Output of `proxspace autobuild`, mounted only while that command runs.
C:\ProxSpace\builds /builds ntfs noacl 0 0
