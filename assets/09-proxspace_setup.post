# ProxSpace environment, sourced by /etc/profile in every login shell.
#
# Unlike the original 09-proxspace_setup.post, this file only sets up the
# environment. Every decision about installing, reinstalling or repairing the
# toolchain is made by proxspace.exe before the shell is ever started, so none
# of it can run here half-way through a login and leave the shell in a state
# nobody chose.

export PSVERSION="@PSVERSION@"
export LANG=en_US.UTF-8
export PS1='\[\033]0;ProxSpace v$PSVERSION - $MSYSTEM:\w\007\033[32m\]pm3 \[\033[33m\]\w\[\033[0m\]$ '
export PATH=/opt/proxspace/bin:$PATH

# The toolchain is the UCRT64 one, so python lives there too. Guarded by
# $MSYSTEM because an MSYS or CLANG64 shell has a different prefix and pointing
# python at the wrong one breaks it outright.
if [ "$MSYSTEM" = "UCRT64" ]; then
    export PYTHONHOME=/ucrt64
fi

# Where proxspace.exe is: one level above the msys2 tree, always, because the
# tree is unpacked next to the binary. Derived at login rather than baked in at
# install time, so moving the whole folder needs no regeneration.
#
# The parent is taken in Windows form and converted afterwards. Going the other
# way round does not work: the tree is itself the root of this mount table, so
# `cygpath -u` on it gives `/`, whose parent is `/` again. `cygpath -w /` ends
# in a backslash, which has to go before the last component can be dropped.
if [ -z "$PROXSPACE_EXE" ]; then
    ps_tree_win="$(cygpath -w /)"
    ps_tree_win="${ps_tree_win%\\}"
    ps_base_win="${ps_tree_win%\\*}"
    export PROXSPACE_EXE="$(cygpath -u "$ps_base_win")/proxspace.exe"
    unset ps_tree_win ps_base_win
fi

alias ls='ls -hF --color=auto'
