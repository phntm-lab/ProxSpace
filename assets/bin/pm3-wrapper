#!/usr/bin/env bash
# Run the proxmark3 script of the same name from the current directory.
#
# Installed under every name the proxmark3 client ships (pm3, pm3-flash,
# pm3-flash-all, pm3-flash-bootrom, pm3-flash-fullimage): all it does is spare
# the user the leading `./` and say something useful when they are in the wrong
# directory. The original ProxSpace had a wrapper of the same shape; this one
# forwards the arguments, which the original dropped, so that `pm3 -p COM3`
# reaches the client with its port.
name=$(basename -- "$0")
if [ ! -f "$name" ]; then
    echo "There is no $name here. Change into the directory of a proxmark3 checkout and try again." >&2
    exit 1
fi
exec "./$name" "$@"
